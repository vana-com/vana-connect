# Copy to `.env.local` and fill in the Privy values from your dev app.
# Never commit `.env.local`. Real secrets do not belong in this file.

# --- Local Postgres (paired with connect/docker-compose.local.yml) -----------
# The runtime auto-selects the `postgres` driver when DATABASE_URL points at
# 127.0.0.1 or localhost; DATABASE_DRIVER=postgres forces that path
# regardless of host.
DATABASE_URL=postgres://vana:vana-local-pw@127.0.0.1:54329/vana_connect?sslmode=disable
DATABASE_DRIVER=postgres

# --- Local Hydra (run from spikes/hydra-v26-poc/docker-compose.yml) ----------
HYDRA_PUBLIC_URL=http://127.0.0.1:4444
HYDRA_ADMIN_URL=http://127.0.0.1:4445

# --- Privy dev app -----------------------------------------------------------
# Create a dev app at https://dashboard.privy.io and paste its credentials.
# These are NOT secrets to commit -- leave the placeholders in this file.
NEXT_PUBLIC_PRIVY_APP_ID=replace-me-privy-app-id
NEXT_PUBLIC_PRIVY_CLIENT_ID=replace-me-privy-client-id
PRIVY_APP_ID=replace-me-privy-app-id
PRIVY_APP_SECRET=replace-me-privy-app-secret
# Optional: paste the verification key (PEM) if you want to validate Privy
# tokens offline. Leave unset to verify against Privy's JWKS endpoint.
# PRIVY_VERIFICATION_KEY=

# --- Vana-root Privy custom JWT auth ----------------------------------------
# Plan-gated in Privy: requires Custom authentication / JWT-based auth access.
# Keep disabled until the Privy dashboard is configured to trust the JWKS URL
# and use `sub` as the JWT ID claim.
NEXT_PUBLIC_PRIVY_JWT_AUTH_SYNC_ENABLED=false
VANA_AUTH_JWT_PRIVATE_KEY=replace-me-pkcs8-pem-with-escaped-newlines
VANA_AUTH_JWT_KEY_ID=local-dev-rs256-1
VANA_AUTH_JWT_ISSUER=http://localhost:3000
PRIVY_CUSTOM_AUTH_AUDIENCE=replace-me-privy-app-id

# --- Optional grants page launch override ------------------------------------
# NEXT_PUBLIC_GRANTS_TEST_DEEPLINK_URL=
