Output docs/vhs/doctor.gif
Require vana

Set Shell "bash"
Set FontSize 22
Set Width 1200
Set TypingSpeed 50ms
Set CursorBlink false
Set Theme "Catppuccin Mocha"
Set WindowBar Colorful
Set Padding 20
Set Margin 20
Set MarginFill "#7983FF"
Set BorderRadius 10
Set LoopOffset 50%
Set Height 1694

Type "vana doctor"
Sleep 500ms
Enter
Sleep 5000ms
