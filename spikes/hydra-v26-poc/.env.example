# Local POC environment. NEVER use these values in production.
#
# Note: Hydra config lives in config/hydra.yml (bind-mounted into the
# container). The variables below are used only by host-side scripts
# (scripts/smoke.mjs, scripts/register-client.sh).

HYDRA_PUBLIC_URL=http://127.0.0.1:4444
HYDRA_ADMIN_URL=http://127.0.0.1:4445
LOGIN_CONSENT_URL=http://127.0.0.1:3000

# Fixed dev subject mapped to vana_user_id semantics
DEV_VANA_USER_ID=vana_user_dev_123
